{
  "appId": "com.omran.aibuilder",
  "appName": "Omran AI Builder",
  "webDir": "www",
  "server": {
    "url": "https://omran-ai-builder.vercel.app",
    "allowNavigation": [
      "omran-ai-builder.vercel.app",
      "*.vercel.app",
      "accounts.google.com",
      "*.google.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": true
  }
}
